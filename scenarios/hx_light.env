# =============================================================================
# hx_light.env — Reduced-load preset for HX176rs (avoid packetparser saturation)
# =============================================================================
# The full hx_176core.env preset (14,000 flows) drives such a high packet rate
# that Retina's packetparser is fully saturated and throughput collapses ~97%
# in BOTH buffer modes — past the useful measurement range.
#
# This preset lowers the offered load to 2,475 flows (same as the 32-core D32s_v3
# baseline) while keeping a high-headroom receiver, so Retina's per-packet cost
# shows up as a realistic partial overhead rather than a total collapse.
#
#   set -a; source scenarios/hx_light.env; set +a
#   CTX=retina-bench-hx ./scripts/run_hx_abc_sweep.sh
#
# Receiver keeps 175 cores of headroom so it is not the bottleneck; the sender
# offers a moderate load (15 pods x 165 conns = 2,475 flows).
# =============================================================================
RECEIVER_GOMAXPROCS=175
LISTENERS=175
WORKERS=700
CLIENT_GOMAXPROCS=3
CLIENT_PODS=15
CONNECTIONS=165
DURATION=90s
PAYLOAD_SIZES="1024 8192 65536"

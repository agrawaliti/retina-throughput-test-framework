# =============================================================================
# hx_176core.env — Preset to saturate Standard_HX176rs (176 vCPU) nodes
# =============================================================================
# Source before running a sweep to scale the reuseport workload from the
# 32-core Standard_D32s_v3 defaults up to the 176-core HX176rs nodes:
#
#   set -a; source scenarios/hx_176core.env; set +a
#   ./scripts/run_hx_abc_sweep.sh
#
# Scaling rationale (proportional to the 176/31 ≈ 5.6x core increase):
#   RECEIVER_GOMAXPROCS=175  -> receiver uses 175 of 176 cores (1 core headroom
#                               for kernel softirq / system / retina-agent)
#   LISTENERS=175            -> one SO_REUSEPORT listener per receiver core
#   WORKERS=700              -> ~4 reader goroutines per core (matches D32's 124/31)
#   CLIENT_GOMAXPROCS=5      -> per sender pod
#   CLIENT_PODS=50           -> 50 x 5 = 250 sender core-equivalents on the
#                               176-core sender node (~1.4x oversubscribe, matching
#                               D32's 45/32 ratio, so the sender is never the limiter)
#   CONNECTIONS=280          -> 50 x 280 = 14,000 flows (~80 flows per receiver
#                               core, matching D32's 2475/31 ≈ 80)
# =============================================================================
RECEIVER_GOMAXPROCS=175
LISTENERS=175
WORKERS=700
CLIENT_GOMAXPROCS=5
CLIENT_PODS=50
CONNECTIONS=280
DURATION=90s
PAYLOAD_SIZES="1024 8192 65536"
